{
    "name": "threadi/efmlawss3",
    "version": "1.1.1",
    "scripts": {
        "post-install-cmd": [
            "composer dump-autoload"
        ],
        "post-update-cmd": [
            "composer dump-autoload"
        ],
        "pre-autoload-dump": [
            "Aws\\Script\\Composer\\Composer::removeUnusedServices"
        ],
        "test": "phpunit",
        "test-multisite": [
            "@putenv WP_MULTISITE=1",
            "phpunit --filter Multisite"
        ],
        "test-install": "bash bin/install-wp-tests.sh wordpress_test root 'debian' 127.0.0.1 latest",
        "test-install-during-build": "bash bin/install-wp-tests.sh wordpress_test root 'debian' 127.0.0.1 latest false true"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "composer/installers": true
        },
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "apcu-autoloader": true,
        "prepend-autoloader": false,
        "platform-check": false
    },
    "extra": {
        "aws/aws-sdk-php" : [
            "S3"
        ]
    },
    "autoload": {
        "psr-4": {
            "ExternalFilesFromAwsS3\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExternalFilesFromAwsS3\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.4.1",
        "pronamic/wp-documentor": "^1.4.0",
        "automattic/vipwpcs": "^3.1",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.402"
    }
}
